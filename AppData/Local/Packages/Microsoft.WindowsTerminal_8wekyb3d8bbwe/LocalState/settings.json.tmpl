{
    "$help": "https://aka.ms/terminal-documentation",
    "$schema": "https://aka.ms/terminal-profiles-schema",
    "actions": [
        {
            "command": {
                "action": "copy",
                "singleLine": false
            },
            "id": "User.copy.644BA8F2"
        },
        {
            "command": "paste",
            "id": "User.paste"
        },
        {
            "command": {
                "action": "splitPane",
                "split": "auto",
                "splitMode": "duplicate"
            },
            "id": "User.splitPane.A6751878"
        },
        {
            "command": "find",
            "id": "User.find"
        }
    ],
    "copyFormatting": "none",
    "copyOnSelect": false,
    "defaultProfile": "{e72abb56-ab17-50cf-9780-9bbd9b2b850c}",
    "keybindings": [
        {
            "id": "User.copy.644BA8F2",
            "keys": "ctrl+c"
        },
        {
            "id": "User.paste",
            "keys": "ctrl+v"
        },
        {
            "id": "User.find",
            "keys": "ctrl+shift+f"
        },
        {
            "id": "User.splitPane.A6751878",
            "keys": "alt+shift+d"
        }
    ],
    "newTabMenu": [
        {
            "type": "remainingProfiles"
        }
    ],
    "profiles": {
        "defaults": {
            "colorScheme": "Dimidium",
            "font": {
                "face": "UbuntuMono Nerd Font Mono"
            },
            "opacity": 95
        },
        "list": [
            {
                "commandline": "pwsh.exe",
                "guid": "{e72abb56-ab17-50cf-9780-9bbd9b2b850c}",
                "hidden": false,
                "name": "PowerShell",
                "startingDirectory": "%USERPROFILE%",
                "icon": "C:\\Program Files\\PowerShell\\7\\pwsh.exe"
            },
            {
                "hidden": false,
                "name": "WSL",
                "icon": "ms-appx:///ProfileIcons/{9acb9455-ca41-5af7-950f-6bca1bc9722f}.png",
                "commandline": "wsl.exe --cd ~"
            }
            {{- $hosts := (include "dot_local/share/encrypted_ssh_hosts.yaml.age" | decrypt | fromYaml) }}
            {{- range $hostid, $data := $hosts }},
            {
                "closeOnExit": "always",
                "commandline": "pwsh.exe -Command \"& { do { ssh {{ $hostid }}; Read-Host 'Press Enter to reconnect or Ctrl+C to exit' } while ($true) }\"",
                "hidden": false,
                "icon": "\ue703",
                "name": "SSH: {{ $data.name }}"
            }
            {{ end }}
        ]
    },
    "schemes": [],
    "themes": []
}