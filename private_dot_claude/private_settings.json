{
  "effortLevel": "medium",
  "enabledPlugins": {
    "caveman@caveman": false
  },
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/notifier-permission.sh",
            "statusMessage": "Waiting for permission via notification",
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "atuin hook claude-code",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "command": "atuin hook claude-code",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "jq 'if .tool_input.command | contains(\"find\") then {hookSpecificOutput: {hookEventName: \"PreToolUse\", updatedInput: {command: (.tool_input.command + \" | tree --charset ascii --fromfile .\")}}} else {} end'",
            "if": "Bash(find *)",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "atuin hook claude-code",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/notifier-stop.sh",
            "statusMessage": "Sending completion notification",
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "additionalDirectories": [
      "/tmp"
    ],
    "allow": [
      "Bash(ansible-lint)",
      "Bash(ansible-lint *)",
      "Bash(cargo build *)",
      "Bash(go build *)",
      "Bash(/tmp/btr-bkp --version)",
      "Skill(caveman)",
      "Skill(caveman:*)"
    ]
  },
  "skipDangerousModePermissionPrompt": true
}